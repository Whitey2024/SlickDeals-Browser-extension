{
  "manifest_version": 3,
  "name": "Slickdeals Hide AliExpress",
  "version": "1.1.0",
  "description": "Hides all AliExpress deals on Slickdeals.net",
  "content_scripts": [
    {
      "matches": [
        "*://slickdeals.net/*",
        "*://*.slickdeals.net/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "slickdeals-hide-aliexpress@local",
      "strict_min_version": "109.0"
    }
  }
}